# ============================================================
# IAA 中台环境变量模板
# ============================================================
# 复制成 .env 后填真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会进仓库。

# ---- LLM（必填）----
# 任何 OpenAI 兼容网关都可以：DeepSeek / 通义 / 自建 vLLM 等
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- LLM 计价（可选，用于成本统计）----
# 单位：USD / 百万 token。默认值是数量级参考，**请按实际账单校准**，
# 否则 cost_report.py 算出来的钱只能看相对大小，不能对外报数。
LLM_INPUT_PRICE_PER_MTOK=0.15
LLM_OUTPUT_PRICE_PER_MTOK=0.60
LLM_USD_CNY=7.1

# ---- 渠道账号（可选，模拟平台上用于演示抓取配置）----
UNITY_USERNAME=
UNITY_PASSWORD=
MTG_USERNAME=
MTG_PASSWORD=
ADMOB_USERNAME=
ADMOB_PASSWORD=

# ---- Airflow 每日调度时间 ----
AGENT_RUN_TIME=09:00

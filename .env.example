# ===== 数据库配置 =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ad_analytics
DB_USER=postgres
DB_PASSWORD=your_password_here

# ===== 大模型API配置（第4个月会用到）=====
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=qwen-plus

# ===== Embedding配置（第4个月会用到）=====
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 应用配置 =====
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
